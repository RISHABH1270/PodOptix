# Environment variables — never commit real secrets
.env

# Go build output
bin/
*.exe

# Go test cache
*.test
*.out

# IDE files
.idea/
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db
node_modules/
frontend/dist/

# Embedded dashboard artifacts — regenerated by `cd web && npm run build`.
# Keep the folder itself (via .gitkeep) so //go:embed always finds something.
internal/dashboard/dist/*
!internal/dashboard/dist/.gitkeep
