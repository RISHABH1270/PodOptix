{
  "name": "podoptix-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf ../internal/dashboard/dist/assets && tsc && vite build",
    "preview": "vite preview",
    "test:e2e:reset": "docker exec podoptix-db psql -U postgres -c \"DROP DATABASE IF EXISTS podoptix_ui_test WITH (FORCE)\" && docker exec podoptix-redis redis-cli -n 2 FLUSHDB",
    "test:e2e": "npm run test:e2e:reset && playwright test",
    "test:e2e:ui": "npm run test:e2e:reset && playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
